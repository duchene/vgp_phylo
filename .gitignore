# ---------------------------------------------------------------- input data --
# 31 GB of alignments and gene trees. Distributed as singlecopy.tar.gz, never in git.
data/loci/
data/gene_trees/
data/metadata/

# Regenerable in ~16s: scripts/build_manifest.sh 32
data/manifest.tsv

# NOTE: data/species_trees/ IS tracked (76 KB). It is small, and it records the
# human tip-label fix documented in README.md.

# ------------------------------------------------------------------- outputs --
# Working outputs are NOT tracked: results/ holds 120 MB of full-precision tables
# plus results/scf_tables/ (1.2 GB across 112k cached IQ-TREE runs).
# Note `results/*` rather than `results/`: git will not look inside an excluded
# DIRECTORY, so the negation below would never be reached.
results/*
!results/published/

# logs/ is transient, except the provenance record of the production run.
logs/*
!logs/run_full.log

# Figures are tracked in both formats: PNG for viewing, PDF (vector) for
# publication. ~1.2 MB total.

# ------------------------------------------------------------------------- R --
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
*.Rcheck/
*-Ex.R

# ------------------------------------------------------------- tooling-local --
# Machine-specific Claude Code permissions; not shared.
.claude/settings.local.json

# ---------------------------------------------------------------------- misc --
*.tar.gz
.DS_Store
core.*
